APP_ENV=dev

# 说明（先看这里）：
#   1) 本文件面向「本机开发 + SQLite/PG 直连」，保留全部可配置项用于查阅。
#   2) 服务器上的容器化部署不读本文件：docker compose 用仓库根目录 .env（模板为根 .env.example），
#      由 compose 的 environment 注入，DATABASE_URL 的主机名是容器名（postgres/minio），不是 127.0.0.1。
#   3) 两种场景的 .env 都不要提交仓库（apps/api/.gitignore 与根 .gitignore 已各自排除）。

# ---------------------------------------------------------------- 数据库
# 推荐 PostgreSQL 16 + pgvector（镜像 pgvector/pgvector:pg16，已内置 vector 扩展的 .so，无需另装）
#   1) 云端容器只绑回环 127.0.0.1 时，本机先开 SSH 隧道再连：
#        ssh -N -L 5432:127.0.0.1:5432 ubuntu@你的服务器
#   2) 密码用 URL 安全字符（openssl rand -hex 16），避免 @ : / 截断连接串
#   3) vector 是「库级」扩展，每个新建库要单独执行一次：
#        CREATE EXTENSION IF NOT EXISTS vector;
#      （只做建表/CRUD 不装也能跑，用到向量列或向量索引时才必须）
DATABASE_URL=postgresql+psycopg://socialoldcare:CHANGE_ME_PG_PASSWORD@127.0.0.1:5432/socialoldcare
# 仅支持 PostgreSQL（JSONB / pgvector / ON CONFLICT 都是业务前提）。
# 测试库：tests/ 会把库名换成 socialoldcare_test 自动连同一实例，无需单独配置。

# 说明：本文件是「全量可配置项」清单，用于查阅。
# 实际 .env 只需写与本机默认值不同的项，其余交给 app/core/config.py 的默认值。
# 首次启动：AUTO_MIGRATE=true 会自动 alembic upgrade head 建表；
# 管理员账号用 scripts/create_admin.py 创建（密码交互输入，不写进配置）。

# 认证
JWT_SECRET=dev-secret-change-me-please-use-32-bytes-minimum
JWT_EXPIRE_MINUTES=1440
ALLOW_DEMO_LOGIN=true
SEED_ADMIN_PASSWORD=Admin123!

# 启动行为
# APP_ENV=prod 时 config 会强制校验，以下任一不满足则启动直接报错：
#   ALLOW_DEMO_LOGIN=false、AUTO_SEED=false、JWT_SECRET 为 ≥32 字节随机值（openssl rand -hex 32）
AUTO_SEED=true
# 启动时自动 alembic upgrade head；关掉则需手动执行 .venv/bin/alembic upgrade head
AUTO_MIGRATE=true

# 业务参数
BUSINESS_TIMEZONE=Asia/Shanghai
DEFAULT_STATION_ID=1
DEPOSIT_RATIO=0.3

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# 文件存储
# local：落本地磁盘；minio：落对象存储（S3 兼容，也可指向阿里云 OSS/腾讯云 COS 的 S3 网关）
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880
# proxy：字节流经 API 转发（可鉴权、可审计）；redirect：302 到对象存储直链（不占 API 带宽）
FILE_DELIVERY=redirect
# 移动端以 <img src> 直连图片，默认关闭下载鉴权；生产建议改为 true
REQUIRE_FILE_AUTH=false

# MinIO（STORAGE_PROVIDER=minio 时必填）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=socialoldcare-media
MINIO_SECURE=false
MINIO_REGION=us-east-1
# 浏览器可访问的基础地址；留空则用 http(s)://endpoint/bucket 推导
MINIO_PUBLIC_BASE_URL=

# 外部渠道
ONLINE_PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=db

# 微信
WECHAT_APPID=
WECHAT_SECRET=

# Agent（预留，暂未启用）
AGENT_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
