/* ============================================================
   社区养老服务管家 · Design System v2.0
   风格：温润流光 · 灵动康养（Soft Organic Care）
   特点：去边框化、大曲率鹅卵石圆角、弥散光影、悬浮胶囊岛
   ============================================================ */

page {
  background: #F7F6F2;
  color: #1A2420;
  font-size: 30rpx;
  line-height: 1.6;
  font-family: "PingFang SC", "Source Han Sans SC", "Noto Sans SC", -apple-system,
    BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, image, scroll-view, picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1.4;
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  border-radius: 0;
  transition: transform 0.18s ease, opacity 0.18s ease;
}
button::after {
  border: none;
}
button:active {
  transform: scale(0.97);
}

input, textarea {
  font: inherit;
  color: inherit;
}

image {
  display: block;
}

.num,
.amount,
.order-no,
.time {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---------- layout ---------- */
.page {
  padding: 30rpx 32rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}
.page-head {
  margin-bottom: 28rpx;
  padding: 8rpx 4rpx 0;
}
.page.with-action {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}
.row {
  display: flex;
  align-items: center;
}
.row-top {
  display: flex;
  align-items: flex-start;
}
.between {
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; }
.mt24 { margin-top: 24rpx; }
.mt32 { margin-top: 32rpx; }
.mb8 { margin-bottom: 8rpx; }
.mb16 { margin-bottom: 16rpx; }
.mb24 { margin-bottom: 24rpx; }

/* ---------- typography ---------- */
.eyebrow {
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #8C9690;
  text-transform: uppercase;
  font-weight: 600;
}
.title {
  font-size: 46rpx;
  line-height: 1.28;
  font-weight: 700;
  color: #1A2420;
  letter-spacing: 0.5rpx;
}
.subtitle {
  font-size: 33rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #1A2420;
}
.body {
  font-size: 30rpx;
  line-height: 1.7;
  color: #1A2420;
}
.small {
  font-size: 26rpx;
  line-height: 1.55;
  color: #54615B;
}
.micro {
  font-size: 24rpx;
  line-height: 1.45;
  color: #8C9690;
}
.muted { color: #8C9690; }
.secondary { color: #54615B; }
.brand-text { color: #1F6345; }
.accent-text { color: #E87A48; }
.bold { font-weight: 600; }
.amount {
  color: #E87A48;
  font-weight: 700;
  font-size: 36rpx;
}
.amount.large {
  font-size: 46rpx;
}
.order-no {
  color: #9AA39E;
  font-size: 22rpx;
}

/* ---------- organic surfaces (borderless & soft floating) ---------- */
.card {
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 34rpx 32rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 20rpx 50rpx -12rpx rgba(22, 74, 51, 0.06),
              0 4rpx 16rpx rgba(22, 74, 51, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}
.card.organic {
  border-radius: 44rpx 36rpx 48rpx 32rpx;
}
.card.flat {
  box-shadow: none;
  background: #F1EFEA;
}
.card.warm {
  background: linear-gradient(135deg, #FFF6EE 0%, #FDF1E6 100%);
  box-shadow: 0 12rpx 32rpx -8rpx rgba(232, 122, 72, 0.08);
}
.card.tight {
  padding: 26rpx 28rpx;
}
.divider {
  height: 2rpx;
  background: linear-gradient(90deg, rgba(22,74,51,0.02) 0%, rgba(22,74,51,0.07) 50%, rgba(22,74,51,0.02) 100%);
  margin: 26rpx 0;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 6rpx 20rpx;
}
.section-title {
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #1A2420;
  position: relative;
}
.section-action {
  font-size: 26rpx;
  color: #1F6345;
  background: #E6F3EC;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

/* ---------- fluid pill buttons ---------- */
.btn-primary,
.btn-ghost,
.btn-warn,
.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #277A55 0%, #164A33 100%);
  color: #FFFFFF;
  box-shadow: 0 16rpx 36rpx -6rpx rgba(22, 74, 51, 0.28);
}
.btn-primary[disabled] {
  background: #C5D1CB;
  color: #FFFFFF;
  box-shadow: none;
}
.btn-ghost {
  background: #EDF4F0;
  color: #1F6345;
}
.btn-warn {
  background: linear-gradient(135deg, #F28B5B 0%, #DF6832 100%);
  color: #FFFFFF;
  box-shadow: 0 16rpx 36rpx -6rpx rgba(223, 104, 50, 0.28);
}
.btn-danger {
  background: #FDECE9;
  color: #C93B2B;
}
.btn-text {
  display: inline-flex;
  align-items: center;
  font-size: 28rpx;
  color: #1F6345;
  background: transparent;
}
.btn-block {
  width: 100%;
}
.small-btn {
  width: auto;
  height: 68rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}

/* ---------- soft organic forms ---------- */
.field {
  margin-top: 26rpx;
}
.label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #54615B;
  margin-bottom: 12rpx;
  padding-left: 6rpx;
}
.label.required::after {
  content: " *";
  color: #E87A48;
}
.input {
  width: 100%;
  min-height: 92rpx;
  padding: 22rpx 30rpx;
  background: #F3F2EE;
  border-radius: 26rpx;
  font-size: 30rpx;
  color: #1A2420;
  transition: background 0.2s ease;
}
.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx 30rpx;
  background: #F3F2EE;
  border-radius: 28rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #1A2420;
}
.helper {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8C9690;
  padding-left: 8rpx;
}
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- quick chips (convenient selection) ---------- */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: #F3F2EE;
  color: #54615B;
  font-size: 27rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}
.chip.active {
  background: linear-gradient(135deg, #277A55 0%, #164A33 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx -6rpx rgba(22, 74, 51, 0.25);
  font-weight: 600;
}
.chip.warm-active {
  background: linear-gradient(135deg, #F28B5B 0%, #DF6832 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx -6rpx rgba(223, 104, 50, 0.25);
  font-weight: 600;
}

/* ---------- tags ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
}
.tag-pending {
  background: #FFF3DF;
  color: #B26A12;
}
.tag-blue {
  background: #EAF2FB;
  color: #2F6FB2;
}
.tag-assigned {
  background: #FFF0E2;
  color: #C25E0A;
}
.tag-inservice {
  background: #FFE8DE;
  color: #C94A2A;
}
.tag-completed {
  background: #E8F3EC;
  color: #2F7D5B;
}
.tag-cancel {
  background: #EFECE6;
  color: #7A847E;
}
.tag-orange {
  background: #FFF0E6;
  color: #D96B38;
}
.tag-green {
  background: #E6F3EC;
  color: #1F6345;
}
.tag-gray {
  background: #EFECE6;
  color: #6E7872;
}
.tag-red {
  background: #FDECE9;
  color: #C93B2B;
}

/* ---------- avatar ---------- */
.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 34rpx 38rpx 32rpx 38rpx;
  background: linear-gradient(135deg, #E6F3EC 0%, #D2EADF 100%);
  color: #164A33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.avatar.large {
  width: 116rpx;
  height: 116rpx;
  font-size: 46rpx;
}
.avatar.cream {
  background: linear-gradient(135deg, #FFF5E8 0%, #F6E3BA 100%);
  color: #8A5A24;
}

/* ---------- list ---------- */
.list-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(22, 74, 51, 0.05);
}
.list-item:last-child {
  border-bottom: none;
}
.list-item:active {
  opacity: 0.75;
}
.chevron {
  color: #B2BBB5;
  font-size: 32rpx;
  margin-left: 10rpx;
}

/* ---------- empty / loading ---------- */
.empty {
  text-align: center;
  padding: 88rpx 32rpx;
}
.empty-mark {
  width: 116rpx;
  height: 116rpx;
  line-height: 116rpx;
  margin: 0 auto 24rpx;
  border-radius: 42rpx 36rpx 46rpx 34rpx;
  background: linear-gradient(135deg, #E6F3EC 0%, #D2EADF 100%);
  color: #1F6345;
  font-size: 42rpx;
  font-weight: 700;
  text-align: center;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2420;
}
.empty-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #8C9690;
}
.empty-action {
  margin-top: 32rpx;
}

.skeleton {
  background: linear-gradient(90deg, #ECEAE4 25%, #F5F4F0 37%, #ECEAE4 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
  border-radius: 20rpx;
}
@keyframes skeleton {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* ---------- floating island action bar ---------- */
.action-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 22rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  border-radius: 999rpx;
  box-shadow: 0 24rpx 60rpx -12rpx rgba(22, 36, 32, 0.16),
              0 0 0 1rpx rgba(255, 255, 255, 0.9) inset;
}
.action-bar .btn-primary,
.action-bar .btn-ghost,
.action-bar .btn-warn {
  flex: 1;
  height: 84rpx;
}
.action-bar .btn-ghost {
  flex: 0 0 210rpx;
}

/* ---------- organic timeline ---------- */
.timeline {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
}
.step {
  flex: 1;
  text-align: center;
  position: relative;
}
.step-line {
  position: absolute;
  top: 20rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  background: #ECEAE4;
  border-radius: 999rpx;
}
.step:last-child .step-line {
  display: none;
}
.step-dot {
  position: relative;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #F3F2EE;
  border: 4rpx solid #E2E0D8;
  color: #8C9690;
  font-size: 20rpx;
  text-align: center;
  font-weight: 700;
}
.step.done .step-dot {
  background: #1F6345;
  border-color: #D2EADF;
  color: #FFFFFF;
}
.step.done .step-line {
  background: linear-gradient(90deg, #1F6345, #A5D2BD);
}
.step.current .step-dot {
  background: #E87A48;
  border-color: #FFE4D4;
  color: #FFFFFF;
  box-shadow: 0 0 0 8rpx rgba(232, 122, 72, 0.15);
}
.step-label {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8C9690;
}
.step.done .step-label,
.step.current .step-label {
  color: #1A2420;
  font-weight: 600;
}
