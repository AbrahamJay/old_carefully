<view class="page">
  <view class="page-head">
    <view class="eyebrow">PROFILE</view>
    <view class="title mt8">{{id ? '编辑长辈' : '新增长辈'}}</view>
    <view class="small muted mt8">信息只用于服务安排，健康备注请尽量简短。</view>
  </view>

  <view class="card organic">
    <view class="section-title">基本信息</view>
    <view class="field">
      <view class="label required">姓名</view>
      <input class="input" value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="长辈姓名" />
    </view>
    <view class="field">
      <view class="label">手机号</view>
      <input class="input" type="number" value="{{form.phone}}" data-field="phone" bindinput="onInput" placeholder="长辈或家属手机" />
    </view>
    <view class="field">
      <view class="label required">服务区域</view>
      <picker mode="selector" range="{{stations}}" range-key="name" value="{{stationIndex}}" bindchange="onStationChange">
        <view class="picker-value">
          <text>{{stationName || '暂无可选区域'}}</text>
          <text class="chevron">›</text>
        </view>
      </picker>
      <view class="helper" wx:if="{{stations.length === 1}}">当前只有一个服务区域，已默认选择。</view>
    </view>
    <view class="field">
      <view class="label">社区</view>
      <input class="input" value="{{form.community}}" data-field="community" bindinput="onInput" placeholder="例如 示范社区" />
    </view>
    <view class="field">
      <view class="label">地址</view>
      <input class="input" value="{{form.address}}" data-field="address" bindinput="onInput" placeholder="楼栋 / 单元 / 门牌" />
    </view>
  </view>

  <view class="card organic">
    <view class="section-title">照护备注</view>
    <view class="field">
      <textarea class="textarea" value="{{form.health_notes}}" data-field="health_notes" bindinput="onInput" placeholder="高血压、行动不便、需陪同复查等（非医疗诊断）" />
      <view class="helper">这些信息会帮助服务人员提前准备，不会对外公开。</view>
    </view>
  </view>

  <view class="card organic">
    <view class="section-title">紧急联系人</view>
    <view class="field">
      <view class="label">姓名</view>
      <input class="input" value="{{form.emergency_name}}" data-field="emergency_name" bindinput="onInput" placeholder="姓名" />
    </view>
    <view class="field">
      <view class="label">电话</view>
      <input class="input" type="number" value="{{form.emergency_phone}}" data-field="emergency_phone" bindinput="onInput" placeholder="电话" />
    </view>
  </view>

  <view class="card organic">
    <checkbox-group bindchange="onAgree">
      <label class="row">
        <checkbox value="1" checked="{{agreed}}" color="#1F5D3F" />
        <text class="small agree-text">我已获得长辈及家属授权，同意收集必要的服务信息（隐私政策见“我的”）</text>
      </label>
    </checkbox-group>
  </view>

  <button class="btn-primary btn-block" loading="{{loading}}" bindtap="save">保存</button>
</view>
