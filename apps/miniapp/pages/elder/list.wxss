.page-head { margin-bottom: 24rpx; }
.head-title-row { margin-top: 8rpx; }
.head-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.head-btn {
  flex: 1;
  width: auto;
  height: 82rpx;
  font-size: 28rpx;
}
.elder-info { margin-left: 20rpx; min-width: 0; }
.elder-card:active { opacity: 0.8; }

.invite-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(22, 74, 51, 0.05);
}
.invite-label { font-size: 22rpx; color: #8C9690; }
.invite-code {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #1F6345;
  background: #E6F3EC;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.invite-copy { margin-left: auto; font-size: 22rpx; color: #1F6345; padding: 4rpx 12rpx; }
