.page-head { margin-bottom: 22rpx; }
.emergency-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #FFF6EE 0%, #FCE7DA 100%);
  border-radius: 42rpx 36rpx 46rpx 34rpx;
  padding: 34rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 18rpx 44rpx -14rpx rgba(232, 122, 72, 0.16);
}
.emergency-label { font-size: 23rpx; color: #A95522; letter-spacing: 1rpx; }
.emergency-number { margin: 10rpx 0 24rpx; font-size: 78rpx; line-height: 1; font-weight: 700; color: #C93B2B; font-variant-numeric: tabular-nums; }
.call-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(22, 74, 51, 0.05);
}
.call-item:last-child { border-bottom: none; }
.call-btn {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #E6F3EC;
  color: #1F6345;
  font-size: 25rpx;
  font-weight: 600;
}
