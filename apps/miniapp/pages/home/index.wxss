.hero-shell {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx 34rpx;
  border-radius: 48rpx 40rpx 56rpx 36rpx;
  background: radial-gradient(circle at 88% 14%, #388C65 0%, #1E6143 52%, #13402B 100%);
  color: #FFFFFF;
  box-shadow: 0 24rpx 52rpx -12rpx rgba(22, 74, 51, 0.24);
}
.hero-aura {
  position: absolute;
  border-radius: 50%;
}
.aura-1 {
  width: 360rpx;
  height: 360rpx;
  right: -120rpx;
  top: -120rpx;
  background: radial-gradient(circle, rgba(246, 227, 186, 0.24) 0%, rgba(246, 227, 186, 0) 70%);
}
.aura-2 {
  width: 280rpx;
  height: 280rpx;
  left: -80rpx;
  bottom: -100rpx;
  background: radial-gradient(circle, rgba(114, 212, 166, 0.18) 0%, rgba(114, 212, 166, 0) 70%);
}
.hero-head {
  position: relative;
  z-index: 1;
}
.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.13);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}
.pulse-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #A9F5CE;
  box-shadow: 0 0 0 6rpx rgba(169, 245, 206, 0.25);
}
.hero-greeting {
  margin-top: 18rpx;
  font-size: 46rpx;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}
.hero-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 36rpx 40rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #FFF7E8 0%, #F6E3BA 100%);
  color: #164A33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.12);
}

.hero-dock {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}
.dock-btn {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}
.dock-btn.main {
  background: #FFFFFF;
  color: #1A2420;
  box-shadow: 0 14rpx 30rpx rgba(14, 46, 31, 0.18);
}
.dock-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 22rpx;
  background: #E6F3EC;
  color: #1F6345;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.dock-icon.warm {
  background: rgba(246, 227, 186, 0.22);
  color: #F6E3BA;
}
.dock-title {
  font-size: 28rpx;
  font-weight: 700;
}
.dock-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  opacity: 0.72;
}

/* ---------- organic bento services ---------- */
.bento-featured {
  position: relative;
  overflow: hidden;
  padding: 30rpx 30rpx 28rpx;
  border-radius: 42rpx 36rpx 46rpx 34rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF7F0 100%);
  box-shadow: 0 20rpx 48rpx -12rpx rgba(232, 122, 72, 0.12),
              0 4rpx 14rpx rgba(22, 74, 51, 0.04);
}
.featured-glow {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  right: -60rpx;
  top: -80rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 122, 72, 0.14) 0%, rgba(232, 122, 72, 0) 70%);
}
.featured-badge {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #FFF0E6;
  color: #D96B38;
  font-size: 22rpx;
  font-weight: 600;
}
.featured-price {
  font-size: 38rpx;
  font-weight: 700;
  color: #E87A48;
  font-variant-numeric: tabular-nums;
}
.featured-price .unit {
  font-size: 22rpx;
  font-weight: 500;
  color: #8C9690;
}
.featured-main {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 22rpx;
}
.featured-seal {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 32rpx 36rpx 28rpx 36rpx;
  background: linear-gradient(135deg, #277A55 0%, #164A33 100%);
  color: #FFFFFF;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 12rpx 24rpx -6rpx rgba(22, 74, 51, 0.25);
}
.featured-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2420;
}
.featured-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6E7872;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.featured-cta {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #1F6345;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.bento-duo {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.duo-card {
  flex: 1;
  padding: 28rpx 26rpx;
  border-radius: 36rpx 42rpx 34rpx 40rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 40rpx -12rpx rgba(22, 74, 51, 0.06);
}
.duo-card.warm-tint {
  border-radius: 42rpx 34rpx 40rpx 36rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #F4FAF6 100%);
}
.duo-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 24rpx 28rpx 22rpx 26rpx;
  background: #E6F3EC;
  color: #1F6345;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
}
.duo-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #E87A48;
}
.duo-title {
  margin-top: 20rpx;
  font-size: 31rpx;
  font-weight: 700;
  color: #1A2420;
}
.duo-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8C9690;
}

.capsule-strip {
  white-space: nowrap;
  margin-top: 20rpx;
}
.mini-capsule {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 26rpx 14rpx 16rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 26rpx -8rpx rgba(22, 74, 51, 0.06);
}
.mini-capsule.urgent {
  background: #FFF2EC;
}
.cap-dot {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background: #E6F3EC;
  color: #1F6345;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}
.cap-dot.urgent {
  background: #E87A48;
  color: #FFFFFF;
}
.cap-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A2420;
}
.cap-price {
  font-size: 23rpx;
  color: #E87A48;
  font-weight: 600;
}

.staff-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 26rpx 28rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #FFF5EC 0%, #FFEAD9 100%);
}
.staff-seal {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 26rpx;
  background: #E87A48;
  color: #FFFFFF;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
}
.staff-go {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #E87A48;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.order-bubble {
  background: #FFFFFF;
  border-radius: 38rpx 34rpx 42rpx 34rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 16rpx 40rpx -12rpx rgba(22, 74, 51, 0.06);
}
.order-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #277A55;
  margin-right: 14rpx;
}
.order-service {
  font-size: 31rpx;
  font-weight: 700;
}
.order-meta {
  margin-top: 10rpx;
  padding-left: 30rpx;
  font-size: 25rpx;
  color: #6E7872;
}

.steward-island {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1E6143 0%, #143D2A 100%);
  color: #FFFFFF;
  box-shadow: 0 20rpx 44rpx -12rpx rgba(22, 74, 51, 0.25);
}
.steward-avatar {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 50%;
  background: #F6E3BA;
  color: #164A33;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.steward-title {
  font-size: 29rpx;
  font-weight: 700;
}
.steward-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}
.steward-call {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #F6E3BA;
  color: #164A33;
  font-size: 25rpx;
  font-weight: 700;
}
