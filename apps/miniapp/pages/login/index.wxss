.login-page {
  min-height: 100vh;
  background: #F7F6F2;
  display: flex;
  flex-direction: column;
}

.login-canvas {
  position: relative;
  overflow: hidden;
  padding: calc(84rpx + env(safe-area-inset-top)) 44rpx 110rpx;
  background: radial-gradient(circle at 85% 18%, #358762 0%, #1D5E41 48%, #123E2A 100%);
  color: #FFFFFF;
  border-radius: 0 0 72rpx 72rpx;
}

.blob {
  position: absolute;
  border-radius: 50%;
}
.blob-1 {
  width: 420rpx;
  height: 420rpx;
  right: -120rpx;
  top: -100rpx;
  background: radial-gradient(circle, rgba(246, 227, 186, 0.22) 0%, rgba(246, 227, 186, 0) 70%);
}
.blob-2 {
  width: 320rpx;
  height: 320rpx;
  left: -100rpx;
  bottom: -80rpx;
  background: radial-gradient(circle, rgba(104, 204, 156, 0.2) 0%, rgba(104, 204, 156, 0) 70%);
}
.blob-3 {
  width: 220rpx;
  height: 220rpx;
  right: 60rpx;
  bottom: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}

.brand-pill {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 26rpx 10rpx 12rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
}
.brand-dot {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background: #F6E3BA;
  color: #164A33;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}
.brand-text-light {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  margin-top: 44rpx;
}
.hero-line {
  font-size: 54rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.hero-line.highlight {
  color: #F6E3BA;
}

.hero-tags {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 32rpx;
}
.hero-tag {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
}

.login-sheet {
  position: relative;
  z-index: 2;
  margin: -64rpx 28rpx 0;
  padding: 40rpx 34rpx 44rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  box-shadow: 0 28rpx 64rpx -16rpx rgba(22, 74, 51, 0.1);
}
.sheet-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A2420;
}
.sheet-sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #8C9690;
}

.quick-roles {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.role-pill {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 32rpx;
  background: #F5F4F0;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}
.role-pill.active {
  background: #EBF5F0;
  border-color: #277A55;
  box-shadow: 0 12rpx 28rpx -10rpx rgba(31, 99, 69, 0.18);
}
.role-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 26rpx 30rpx 24rpx 30rpx;
  background: #1F6345;
  color: #FFFFFF;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.role-icon.staff {
  background: #E87A48;
}
.role-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1A2420;
}
.role-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #6E7872;
}

.input-group {
  margin-top: 28rpx;
}
.input-pill {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 28rpx;
  background: #F5F4F0;
  border-radius: 999rpx;
}
.input-prefix {
  width: 110rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #54615B;
}
.pill-field {
  flex: 1;
  font-size: 30rpx;
  color: #1A2420;
  font-variant-numeric: tabular-nums;
}
.login-submit {
  margin-top: 36rpx;
}

.login-foot {
  margin-top: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A0A8A3;
}
