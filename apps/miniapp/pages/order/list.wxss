.page-head { margin-bottom: 22rpx; }
.small-btn {
  width: auto;
  height: 68rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
}
.tabs { white-space: nowrap; margin-bottom: 24rpx; }
.tab {
  display: inline-block;
  padding: 15rpx 30rpx;
  margin-right: 14rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6E7872;
  box-shadow: 0 8rpx 20rpx -10rpx rgba(22, 74, 51, 0.08);
  transition: all 0.2s ease;
}
.tab.active {
  background: linear-gradient(135deg, #277A55 0%, #164A33 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx -8rpx rgba(22, 74, 51, 0.25);
}
.order-bubble {
  background: #FFFFFF;
  border-radius: 40rpx 34rpx 44rpx 34rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 18rpx 44rpx -14rpx rgba(22, 74, 51, 0.08),
              0 3rpx 12rpx rgba(22, 74, 51, 0.03);
}
.order-bubble:active { opacity: 0.82; }
.order-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #277A55;
  margin-right: 14rpx;
  box-shadow: 0 0 0 6rpx rgba(39, 122, 85, 0.1);
}
.order-service { font-size: 31rpx; font-weight: 700; }
.order-meta {
  margin-top: 10rpx;
  padding-left: 30rpx;
  font-size: 25rpx;
  color: #6E7872;
}
.skeleton-list .order-bubble { box-shadow: none; }
.pay-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(22, 74, 51, 0.05);
}
.pay-hint { font-size: 23rpx; color: #C25E0A; }
.pay-action {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #1F6345;
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 600;
}

.order-tags { gap: 8rpx; }
