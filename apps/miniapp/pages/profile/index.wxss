.profile-shell {
  position: relative;
  overflow: hidden;
  padding: 36rpx 34rpx 30rpx;
  margin-bottom: 26rpx;
  border-radius: 48rpx 40rpx 52rpx 38rpx;
  background: radial-gradient(circle at 88% 12%, #388C65 0%, #1E6143 52%, #13402B 100%);
  color: #FFFFFF;
  box-shadow: 0 24rpx 52rpx -12rpx rgba(22, 74, 51, 0.24);
}
.profile-aura {
  position: absolute;
  border-radius: 50%;
}
.profile-aura.a {
  width: 360rpx;
  height: 360rpx;
  right: -130rpx;
  top: -160rpx;
  background: radial-gradient(circle, rgba(246, 227, 186, 0.22) 0%, rgba(246, 227, 186, 0) 70%);
}
.profile-aura.b {
  width: 260rpx;
  height: 260rpx;
  left: -90rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(114, 212, 166, 0.16) 0%, rgba(114, 212, 166, 0) 70%);
}
.hero-top { position: relative; z-index: 1; }
.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 40rpx 44rpx 36rpx 44rpx;
  background: linear-gradient(135deg, #FFF7E8 0%, #F6E3BA 100%);
  color: #164A33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.profile-name { font-size: 40rpx; line-height: 1.3; font-weight: 700; }
.profile-meta { margin-top: 8rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.62); }
.role-pill {
  padding: 9rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  color: #F6E3BA;
}
.profile-stats {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 32rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}
.profile-stat { flex: 1; text-align: center; }
.stat-num { font-size: 32rpx; font-weight: 700; color: #F6E3BA; }
.stat-label { margin-top: 4rpx; font-size: 21rpx; color: rgba(255, 255, 255, 0.52); }

.menu-card { padding: 8rpx 28rpx; }
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(22, 74, 51, 0.05);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { opacity: 0.7; }
.menu-icon {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 24rpx 28rpx 22rpx 26rpx;
  background: #E6F3EC;
  color: #1F6345;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-icon.warm { background: #FFF0E6; color: #D96B38; }
.menu-icon.red { background: #FDECE9; color: #C93B2B; }
.menu-label { font-size: 30rpx; font-weight: 600; color: #1A2420; }
.menu-desc { margin-top: 3rpx; font-size: 22rpx; color: #8C9690; }
