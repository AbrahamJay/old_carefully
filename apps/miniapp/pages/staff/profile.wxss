.profile-shell {
  position: relative;
  overflow: hidden;
  padding: 36rpx 34rpx 30rpx;
  margin-bottom: 26rpx;
  border-radius: 48rpx 40rpx 52rpx 38rpx;
  background: radial-gradient(circle at 88% 12%, #388C65 0%, #1E6143 52%, #13402B 100%);
  color: #FFFFFF;
  box-shadow: 0 24rpx 52rpx -12rpx rgba(22, 74, 51, 0.24);
}
.profile-aura {
  position: absolute;
  border-radius: 50%;
}
.profile-aura.a {
  width: 360rpx;
  height: 360rpx;
  right: -130rpx;
  top: -160rpx;
  background: radial-gradient(circle, rgba(246, 227, 186, 0.22) 0%, rgba(246, 227, 186, 0) 70%);
}
.profile-aura.b {
  width: 260rpx;
  height: 260rpx;
  left: -90rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(114, 212, 166, 0.16) 0%, rgba(114, 212, 166, 0) 70%);
}
.hero-top { position: relative; z-index: 1; }
.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 40rpx 44rpx 36rpx 44rpx;
  background: linear-gradient(135deg, #FFF7E8 0%, #F6E3BA 100%);
  color: #164A33;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.profile-name { font-size: 40rpx; line-height: 1.3; font-weight: 700; }
.profile-meta { margin-top: 8rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.62); }
.profile-station { margin-top: 6rpx; font-size: 22rpx; color: #F6E3BA; }
.role-pill {
  padding: 9rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  color: #F6E3BA;
}

.menu-card { padding: 8rpx 28rpx; }
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(22, 74, 51, 0.05);
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { opacity: 0.7; }
.menu-icon {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 24rpx 28rpx 22rpx 26rpx;
  background: #E6F3EC;
  color: #1F6345;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-icon.warm { background: #FFF0E6; color: #D96B38; }
.menu-label { font-size: 30rpx; font-weight: 600; color: #1A2420; }
.menu-desc { margin-top: 3rpx; font-size: 22rpx; color: #8C9690; }
.account-note {
  margin: 18rpx 8rpx 30rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8C9690;
}

.staff-bottom-nav {
  position: fixed;
  z-index: 20;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 100%;
  max-width: 750rpx;
  display: flex;
  padding: 12rpx 16rpx calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid rgba(22, 74, 51, 0.05);
  backdrop-filter: blur(18rpx);
}
.staff-nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  color: #8C9690;
  font-size: 20rpx;
  font-weight: 600;
}
.staff-nav-item.active { color: #1F6345; }
.staff-nav-icon {
  width: 48rpx;
  height: 48rpx;
  display: block;
}
