.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 9rpx 0;
  font-size: 28rpx;
}
.info-key { color: #8C9690; flex-shrink: 0; }
.info-value { color: #1A2420; text-align: right; }
.info-block { margin-top: 18rpx; }
.info-text { margin-top: 6rpx; font-size: 28rpx; line-height: 1.7; color: #1A2420; }
.photo-grid { display: flex; gap: 14rpx; flex-wrap: wrap; }
.photo-item { position: relative; }
.photo { width: 154rpx; height: 154rpx; border-radius: 26rpx; background: #F3F2EE; }
.remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(26, 36, 32, 0.72);
  color: #FFFFFF;
  font-size: 28rpx;
}
.photo-add {
  width: 154rpx;
  height: 154rpx;
  line-height: 150rpx;
  text-align: center;
  border-radius: 26rpx;
  background: #F5F4F0;
  color: #8C9690;
  font-size: 46rpx;
}

.record {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(22, 74, 51, 0.05);
}
.record:last-child { border-bottom: none; }
.record-time { font-size: 24rpx; color: #8C9690; }
.record-content { margin-top: 8rpx; font-size: 28rpx; line-height: 1.7; color: #1A2420; }

.order-no-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}
.copy-link {
  font-size: 22rpx;
  color: #1F6345;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #E6F3EC;
}

/* AI 服务前提示与草稿区：视觉上与手工填写区分开，强调可跳过 */
.ai-list { margin-top: 16rpx; }
.ai-item {
  position: relative;
  padding-left: 26rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1A2420;
}
.ai-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1F6345;
}
/* 输入框下方一行：左侧说明，右侧小胶囊按钮 */
.ai-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
}
.ai-bar .helper {
  flex: 1;
  margin-top: 0;
  padding-left: 0;
}
.ai-inline {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
  background: #EDF4F0;
  color: #1F6345;
}
/* 输入框为空或正在润色时按钮不可点 */
.is-disabled {
  opacity: 0.45;
}
.ai-undo {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #7C8A84;
}
.ai-undo-link {
  color: #1F6345;
  text-decoration: underline;
}
