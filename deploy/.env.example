# ============================================================================
# 部署环境变量（docker compose 在 deploy/ 目录内读取这里的 .env）
#   用法：cp .env.example .env && vim .env
#   注意：本文件只放「部署/服务器」相关的值，后端业务默认值仍由
#         apps/api/app/core/config.py 提供，不必重复抄一遍。
#
# 改 IP / 换域名时必须同步下面两处（都要求浏览器可达）：
#   - MINIO_PUBLIC_BASE_URL      图片直链前缀（写错则图片打不开）
#   - CORS_ORIGINS               跨域白名单（同域部署下不触发，用于排查）
# ============================================================================

# ---------------------------------------------------------------- 数据库（复用现有容器 pg）
POSTGRES_DB=socialoldcare
POSTGRES_USER=socialoldcare
# 填服务器上旧库的真实密码（旧 apps/api/.env 里那个）；改密码才用 openssl rand -hex 16 生成。
# 必须是 URL 安全字符（仅 0-9a-f），否则 DATABASE_URL 会被 @ : / 截断。
POSTGRES_PASSWORD=CHANGE_ME_HEX_32
# 保持 postgres：靠 docker network alias 指向现有容器 pg（README 第 2 步）
POSTGRES_HOST=postgres

# ---------------------------------------------------------------- 应用与认证
# prod 会强制校验：ALLOW_DEMO_LOGIN=false、AUTO_SEED=false、JWT_SECRET 为 ≥32 字节随机值。
# 这样忘记改密钥时会直接启动失败，而不是带着弱密钥上线。
# 需要在预发环境使用「演示微信登录」时，改成 staging + ALLOW_DEMO_LOGIN=true。
APP_ENV=prod
# openssl rand -hex 32（占位符只有 16 字节，prod 下会启动失败，属于预期保护）
JWT_SECRET=CHANGE_ME_64_HEX
JWT_EXPIRE_MINUTES=1440
ALLOW_DEMO_LOGIN=false
# 关闭演示种子数据：基础数据用 sql/*.sql 导入，管理员用 scripts/create_admin.py 创建
AUTO_SEED=false
# 启动时自动 alembic upgrade head；改成 false 则必须手动执行迁移
AUTO_MIGRATE=true
# 可跨域的来源，英文逗号分隔；同域部署下浏览器不会触发 CORS
CORS_ORIGINS=http://120.53.13.162,http://127.0.0.1:5173,http://localhost:5173

# ---------------------------------------------------------------- 业务参数
BUSINESS_TIMEZONE=Asia/Shanghai
DEFAULT_STATION_ID=1
DEPOSIT_RATIO=0.3

# ---------------------------------------------------------------- 文件存储（MinIO，已在 9000 端口）
STORAGE_PROVIDER=minio
# 二选一：
#   MinIO 是容器 → minio:9000（README 第 2 步把它也接入 socialoldcare-net 并起别名 minio）
#   MinIO 是宿主机二进制 → host.docker.internal:9000
MINIO_ENDPOINT=minio:9000
# 不要使用默认的 minioadmin；填服务器上现有 MinIO 的 access key
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
# 填服务器上现有 MinIO 的 secret key（含 @ 等字符不影响，它不参与 URL 拼接）
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=socialoldcare-media
MINIO_SECURE=false
# 浏览器可直连的前缀：图片 302 到这里，不走 API 带宽
# 现有 MinIO 直连时用 http://<服务器IP>:9000/<bucket>；改用 nginx 反代时填 http://<域名>/media
MINIO_PUBLIC_BASE_URL=http://120.53.13.162:9000/socialoldcare-media
# redirect：302 到对象存储直链；proxy：字节流经 API（可鉴权、可审计）
FILE_DELIVERY=redirect
# 移动端 <img src> 直连图片时须为 false；改为 true 后图片要走带 token 的接口
REQUIRE_FILE_AUTH=false

# ---------------------------------------------------------------- 外部渠道（按需填写）
WECHAT_APPID=
WECHAT_SECRET=
ONLINE_PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=db

# ---------------------------------------------------------------- 异常巡检
# worker 容器每 N 分钟扫一次；阈值与 apps/api/app/core/config.py 默认值一致，按运营调整
ANOMALY_SCAN_ENABLED=true
ANOMALY_SCAN_INTERVAL_MINUTES=10
ANOMALY_PENDING_CONFIRM_MINUTES=120
ANOMALY_CONFIRMED_UNASSIGNED_MINUTES=60
ANOMALY_ASSIGNED_NOT_ACCEPTED_MINUTES=30
ANOMALY_IN_SERVICE_OVERRUN_MINUTES=60
ANOMALY_BALANCE_DUE_HOURS=24

# ---------------------------------------------------------------- Agent（LLM）
# 关闭时 /agent/* 返回 503，前端隐藏 AI 入口；主业务流程不受影响。
# 生产禁止 mock；LLM_BASE_URL 必须为 https。
AGENT_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=<DEEPSEEK_API_KEY>
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
AGENT_PREP_MAX_TOKENS=300
# 关闭混合思考模型的推理过程（DeepSeek/Qwen 支持）；网关不认该字段时设为 false
LLM_DISABLE_THINKING=true
AGENT_DAILY_LIMIT_PER_USER=50
# 管理端解释场景（派单建议 / 异常解释）单独额度与输出上限
AGENT_ADMIN_DAILY_LIMIT_PER_USER=100
AGENT_DISPATCH_MAX_TOKENS=400
AGENT_TASK_MAX_TOKENS=300
# 同一订单/任务在秒数内复用上次解释；0 表示不缓存
AGENT_CACHE_TTL_SECONDS=600
# 员工「这单助手」对话：单独一套额度，避免多轮问答吃掉写记录的次数
AGENT_CHAT_DAILY_LIMIT_PER_USER=40
# 回答上限按 120 字反推；历史条数与单条发言长度也要限，否则 prompt 会被撑大
AGENT_CHAT_MAX_TOKENS=400
AGENT_CHAT_HISTORY_TURNS=6
AGENT_CHAT_MESSAGE_MAX_CHARS=200
