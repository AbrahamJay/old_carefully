# ============================================================================
# 管理后台镜像（服务器部署用）
# 构建上下文 = 仓库根目录（deploy/docker-compose.yml 里 context: ..），
# 因此 COPY 路径带 apps/admin 前缀；根目录 .dockerignore 已排除 node_modules/dist。
# ============================================================================
FROM node:22-alpine AS build
WORKDIR /app
# 默认走 npmmirror；需要官方源时：
#   docker compose build --build-arg NPM_REGISTRY=https://registry.npmjs.org admin
ARG NPM_REGISTRY=https://registry.npmmirror.com
# 不用 corepack：它会去 registry.npmjs.org 拉 pnpm 并校验签名，配镜像源反而容易失败
RUN npm config set registry "$NPM_REGISTRY" && npm i -g pnpm@10 --silent

COPY apps/admin/package.json apps/admin/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY apps/admin/ ./
RUN pnpm build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx/admin.conf /etc/nginx/conf.d/default.conf
