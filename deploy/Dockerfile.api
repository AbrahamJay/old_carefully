# ============================================================================
# 后端镜像（服务器部署用）
# - 依赖用 deploy/requirements.txt + pip 安装，不依赖 ghcr.io 的 uv 镜像（国内常拉不动）
# - 构建上下文 = 仓库根目录，由 deploy/docker-compose.yml 的 context: .. 指定
# ============================================================================
FROM python:3.12-slim

# tzdata：app/core/time.py 用 ZoneInfo("Asia/Shanghai")，slim 镜像默认没有时区库
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 依赖单独一层：只改业务代码时不会重装依赖
COPY deploy/requirements.txt ./requirements.txt
# 默认走清华源；需要官方源时：
#   docker compose build --build-arg PIP_INDEX_URL=https://pypi.org/simple api
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt

COPY apps/api/app ./app
# 启动时的 AUTO_MIGRATE 与运维脚本依赖这些文件，缺了会直接报错
COPY apps/api/alembic.ini ./
COPY apps/api/migrations ./migrations
COPY apps/api/sql ./sql
COPY apps/api/scripts ./scripts

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Shanghai

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
